# Copiar a .env y completar. .env NO se versiona (el repositorio es publico).

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=ecoharmony
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=ecoharmony
POSTGRES_PUERTO=5433

# --- Conexiones de la aplicacion (misma clave que arriba) ---
DATABASE_URL=postgresql://ecoharmony:cambiar-esta-clave@localhost:5433/ecoharmony
DATABASE_URL_TEST=postgresql://ecoharmony:cambiar-esta-clave@localhost:5433/ecoharmony_test

# --- Email real por SMTP (Gmail con contrasena de aplicacion, o Brevo) ---
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=tu-casilla@gmail.com
SMTP_CLAVE=contrasena-de-aplicacion
EMAIL_REMITENTE=tu-casilla@gmail.com
